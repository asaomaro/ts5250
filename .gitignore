*.local.json

# 認証ユーザーファイル（秘密。コミットしない）
users.local.json
**/users.local.json
users.json

# ユーザー接続設定（サーバー保存・秘匿）
connections.json
connections.json.tmp

# サーバー設定（--profiles の既定の保存先）。接続先・ユーザー名・暗号化パスワードが入る。
# 雛形は packages/server/profiles.json.example（こちらは追跡する）
profiles.json
profiles.json.tmp

# 画面マクロ（--macros の保存先）。記録した秘密を secretEnc（AES-256-GCM）で持つので秘匿扱い
macros.json
macros.json.tmp

# Electron 配布物の組み立て置き場（electron/scripts/prepare-app.mjs が毎回作り直す）
electron/app-stage/

# 5250 の操作ログ書き出し（調査用。実機の画面内容が入るのでコミットしない）
*5250-log*.jsonl

# 画面エビデンスの HTML（get_screen_html / get_screen_history_html の書き出し先）。
# 操作ログと同じく実機の画面内容が入るのでコミットしない
testlib-screens/
*-screens/
spool-html/

# Rust のビルド成果物
/crates/**/target/
