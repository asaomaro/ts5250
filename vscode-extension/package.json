{
  "name": "ts5250-vscode",
  "displayName": "ts5250",
  "description": "IBM i (AS/400) の 5250 エミュレーター・プリンター・スプール・SQL・IFS を設定ファイル（.ts5250emu 等）から開く",
  "version": "0.1.0",
  "publisher": "asaomaro",
  "license": "Apache-2.0",
  "private": true,
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/asaomaro/ts5250.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCustomEditor:ts5250.editor"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "ts5250.editor",
        "displayName": "ts5250",
        "selector": [
          {
            "filenamePattern": "*.ts5250emu"
          },
          {
            "filenamePattern": "*.ts5250prt"
          },
          {
            "filenamePattern": "*.ts5250spl"
          },
          {
            "filenamePattern": "*.ts5250sql"
          },
          {
            "filenamePattern": "*.ts5250ifs"
          }
        ],
        "priority": "default"
      }
    ],
    "languages": [
      {
        "id": "ts5250",
        "extensions": [
          ".ts5250emu",
          ".ts5250prt",
          ".ts5250spl",
          ".ts5250sql",
          ".ts5250ifs"
        ],
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      }
    ],
    "configuration": {
      "title": "ts5250",
      "properties": {
        "ts5250.nodePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "通常は空欄のまま同梱 Node.js を使います。外部 Node.js 26.4 以降を使う場合だけ実行ファイルを指定します"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "package": "node scripts/package.mjs",
    "prepare-server": "node scripts/prepare-server.mjs",
    "prepare-runtime": "node scripts/prepare-runtime.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.1.1",
    "fflate": "^0.8.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
