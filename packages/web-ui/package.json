  "devDependencies": {
    "@ts5250/hostserver": "0.1.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "vite": "^8.1.4",
    "vue-tsc": "^3.3.7"
  }
}
