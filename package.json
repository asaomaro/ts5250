{
  "name": "ts5250",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "AS400 (IBM i) 5250 MCP server + Web emulator — pure TypeScript TN5250 implementation",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run typecheck -w @ts5250/web-ui",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "gen:tables": "npm run gen -w @ts5250/gen-tables",
    "gen:icons": "npm run gen:icons -w @ts5250/web-ui"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
