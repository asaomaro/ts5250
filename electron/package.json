{
  "name": "ts5250-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "ts5250 — IBM i (AS/400) 5250 エミュレーター Electron デスクトップ版",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "prepare-app": "node scripts/prepare-app.mjs",
    "dist": "npm run prepare-app && electron-builder"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.asaomaro.ts5250",
    "productName": "ts5250",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs"
    ],
    "extraResources": [
      {
        "from": "app-stage",
        "to": "app"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "ts5250",
      "artifactName": "ts5250-${version}-setup.${ext}"
    }
  }
}
