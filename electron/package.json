{
  "name": "as400-5250-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "AS400 5250 MCP/Web エミュレーター Electron デスクトップ版",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "prepare-app": "node scripts/prepare-app.mjs",
    "dist": "npm run prepare-app && electron-builder"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.asaomaro.as400-5250",
    "productName": "AS400 5250 Emulator",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs"
    ],
    "extraResources": [
      {
        "from": "app-stage",
        "to": "app"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "AS400-5250-Emulator-${version}-portable.${ext}",
      "unpackDirName": "as400-5250-emulator"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    }
  }
}
